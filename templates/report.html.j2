<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>泓济环保·行业日报</title>
<style>
*{margin:0;padding:0;box-sizing:border-box;}
body{background:#e8e4d8;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI","PingFang SC","Hiragino Sans GB","Microsoft YaHei","WenQuanYi Micro Hei",sans-serif;color:#1a1a1a;line-height:1.7;-webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale;}
.paper{max-width:960px;margin:0 auto;background:#f5f1e8;padding:40px 44px 36px;box-shadow:0 4px 30px rgba(0,0,0,0.1);position:relative;}
.paper::before{content:'';position:absolute;top:0;left:0;right:0;bottom:0;background-image:repeating-linear-gradient(0deg,transparent,transparent 3px,rgba(0,0,0,0.008) 3px,rgba(0,0,0,0.008) 4px);pointer-events:none;}
.masthead{text-align:center;border-bottom:3px double #1a1a1a;padding-bottom:16px;margin-bottom:0;position:relative;z-index:1;}
.mast-top{display:flex;justify-content:space-between;align-items:center;font-size:12px;color:#555;margin-bottom:10px;font-family:Georgia,"Times New Roman",serif;}
.mast-top .left{text-align:left;font-weight:600;}
.mast-top .right{text-align:right;font-weight:600;}
.mast-title{font-size:42px;font-weight:800;letter-spacing:6px;margin-bottom:4px;font-family:Georgia,"Noto Serif SC","Songti SC","SimSun",serif;color:#0d0d0d;line-height:1.2;}
.mast-title .en{font-size:12px;font-weight:500;letter-spacing:3px;color:#666;display:block;margin-top:6px;font-family:Georgia,serif;}
.mast-sub{font-size:14px;color:#444;font-style:italic;margin-top:8px;font-weight:500;}
.mast-rule{border-top:2px solid #1a1a1a;margin-top:12px;}
.mast-rule-thin{border-top:1px solid #bbb;margin-top:4px;}
.subbar{display:flex;justify-content:space-between;padding:10px 0 12px;font-size:13px;color:#555;border-bottom:1px solid #bbb;position:relative;z-index:1;}
.subbar .item{display:flex;align-items:center;gap:6px;}
.subbar .item strong{color:#0d0d0d;font-weight:800;font-size:15px;}
.content{position:relative;z-index:1;padding-top:20px;}
.featured{border-bottom:1px solid #999;padding-bottom:22px;margin-bottom:22px;}
.featured .kicker{font-size:11px;letter-spacing:2px;font-weight:800;color:#b71c1c;text-transform:uppercase;margin-bottom:8px;font-family:Georgia,serif;}
.featured h1{font-size:28px;font-weight:800;line-height:1.35;margin-bottom:10px;color:#0d0d0d;}
.featured .deck{font-size:15px;color:#444;font-style:italic;margin-bottom:10px;line-height:1.65;font-weight:500;}
.featured .byline{font-size:12px;color:#777;border-top:1px solid #ddd;border-bottom:1px solid #ddd;padding:5px 0;margin-bottom:12px;display:flex;justify-content:space-between;font-family:Georgia,serif;}
.featured .body-text{font-size:15px;color:#2a2a2a;line-height:1.85;text-align:justify;}
.featured .body-text::first-letter{font-size:36px;font-weight:800;float:left;line-height:1;margin-right:5px;margin-top:2px;color:#0d0d0d;font-family:Georgia,"Noto Serif SC",serif;}
.featured .read-more{font-size:12px;color:#b71c1c;text-decoration:none;font-weight:800;margin-top:8px;display:inline-block;}
.two-col{column-count:2;column-gap:32px;column-rule:1px solid #ddd;padding-bottom:22px;border-bottom:1px solid #999;margin-bottom:22px;}
.two-col .story{break-inside:avoid;margin-bottom:20px;}
.two-col .story h3{font-size:16px;font-weight:800;line-height:1.4;margin-bottom:6px;color:#0d0d0d;}
.two-col .story .meta{font-size:11px;color:#777;margin-bottom:5px;text-transform:uppercase;letter-spacing:0.5px;font-weight:600;font-family:Georgia,serif;}
.two-col .story p{font-size:14px;color:#3a3a3a;line-height:1.75;text-align:justify;}
.two-col .story .read-more{font-size:11px;color:#b71c1c;text-decoration:none;font-weight:800;}
.sec-head{font-size:12px;font-weight:800;letter-spacing:4px;text-transform:uppercase;color:#0d0d0d;border-top:2px solid #1a1a1a;border-bottom:1px solid #1a1a1a;padding:5px 0;margin-bottom:14px;text-align:center;font-family:Georgia,serif;}
.policy-list{padding-bottom:22px;border-bottom:1px solid #999;margin-bottom:22px;}
.pol-item{display:flex;align-items:baseline;gap:10px;padding:8px 0;border-bottom:1px dotted #bbb;transition:background 0.15s;}
.pol-item:hover{background:rgba(21,101,192,0.04);}
.pol-item:last-child{border-bottom:none;}
.pol-bullet{width:7px;height:7px;border-radius:50%;flex-shrink:0;position:relative;top:7px;}
.pol-new{background:#b71c1c;}
.pol-active{background:#1565c0;}
.pol-text{font-size:14px;color:#2a2a2a;flex:1;line-height:1.55;font-weight:500;}
.pol-text strong{font-weight:800;}
.pol-text a{color:#1565c0;text-decoration:none;font-weight:800;}
.pol-text a:hover{text-decoration:underline;}
.pol-text .status{font-size:10px;padding:2px 7px;border-radius:2px;font-weight:800;margin-right:7px;letter-spacing:0.5px;font-family:Georgia,serif;}
.st-new{background:#fce8e8;color:#b71c1c;}
.st-active{background:#e3f2fd;color:#1565c0;}
.pol-date{font-size:12px;color:#888;white-space:nowrap;font-family:Georgia,serif;font-weight:600;}
.briefs{column-count:3;column-gap:22px;padding-bottom:22px;border-bottom:1px solid #999;margin-bottom:22px;}
.brief{break-inside:avoid;margin-bottom:14px;}
.brief h4{font-size:13px;font-weight:800;margin-bottom:3px;line-height:1.45;color:#0d0d0d;}
.brief .meta{font-size:11px;color:#777;margin-bottom:5px;font-weight:500;}
.brief p{font-size:12px;color:#444;line-height:1.65;}
.keywords{padding:14px 0;border-bottom:1px solid #999;margin-bottom:18px;text-align:center;}
.kw-label{font-size:11px;letter-spacing:2px;text-transform:uppercase;color:#777;margin-bottom:10px;font-family:Georgia,serif;font-weight:700;}
.kw-chips{display:flex;flex-wrap:wrap;justify-content:center;gap:10px;}
.kw-chip{font-size:12px;padding:4px 14px;border:1px solid #1a1a1a;font-weight:600;background:#f5f1e8;}
.kw-chip.featured-chip{background:#1a1a1a;color:#f5f1e8;}
.colophon{text-align:center;padding-top:14px;font-size:11px;color:#888;line-height:1.9;font-family:Georgia,serif;position:relative;z-index:1;}
.colophon .name{font-size:13px;color:#0d0d0d;font-weight:800;letter-spacing:2px;margin-bottom:3px;}
.colophon .links{margin-top:10px;display:flex;justify-content:center;gap:16px;}
.colophon .links a{font-size:11px;color:#555;text-decoration:none;border-bottom:1px solid transparent;font-weight:600;}
.colophon .links a:hover{border-bottom-color:#555;}
@media(max-width:768px){
  .paper{max-width:100%;padding:28px 26px 24px;}
  .mast-title{font-size:32px;letter-spacing:4px;}
  .mast-title .en{font-size:11px;}
  .subbar{font-size:12px;flex-wrap:wrap;gap:8px 12px;}
  .subbar .item strong{font-size:14px;}
  .featured h1{font-size:23px;}
  .featured .deck{font-size:14px;}
  .featured .body-text{font-size:14px;}
  .two-col{column-count:1;column-rule:none;}
  .briefs{column-count:2;column-gap:18px;}
  .policy-list .pol-item{flex-wrap:wrap;}
  .pol-date{width:100%;text-align:right;margin-top:2px;}
}
@media(max-width:480px){
  .paper{padding:18px 16px 16px;}
  .mast-top{font-size:10px;}
  .mast-title{font-size:26px;letter-spacing:2px;}
  .mast-title .en{font-size:9px;margin-top:4px;letter-spacing:1px;}
  .mast-sub{font-size:12px;}
  .subbar{flex-direction:row;flex-wrap:wrap;gap:6px 10px;font-size:11px;padding:8px 0;}
  .subbar .item strong{font-size:13px;}
  .featured{padding-bottom:16px;margin-bottom:16px;}
  .featured .kicker{font-size:10px;}
  .featured h1{font-size:19px;}
  .featured .deck{font-size:13px;margin-bottom:8px;}
  .featured .byline{font-size:11px;}
  .featured .body-text{font-size:13px;line-height:1.75;}
  .featured .body-text::first-letter{font-size:28px;}
  .two-col{padding-bottom:16px;margin-bottom:16px;}
  .two-col .story{margin-bottom:16px;}
  .two-col .story h3{font-size:15px;}
  .two-col .story p{font-size:13px;}
  .sec-head{font-size:11px;letter-spacing:2px;margin-bottom:10px;}
  .policy-list{padding-bottom:14px;margin-bottom:14px;}
  .pol-item{padding:6px 0;gap:8px;}
  .pol-text{font-size:13px;line-height:1.5;}
  .pol-date{font-size:10px;}
  .briefs{display:none;}
  .keywords{padding:10px 0;margin-bottom:12px;}
  .kw-chips{gap:6px;}
  .kw-chip{font-size:11px;padding:3px 10px;}
  .colophon{font-size:10px;}
  .colophon .links{gap:12px;}
}
</style>
</head>
<body>
<div class="paper">
  <div class="masthead">
    <div class="mast-top">
      <div class="left">第 {{ issue_num }} 期</div>
      <div class="right">{{ date }} {{ weekday }}</div>
    </div>
    <div class="mast-title">泓济行业日报<span class="en">HONESS ENVIRONMENTAL DAILY</span></div>
    <div class="mast-sub">专注水处理 · 服务环保人</div>
    <div class="mast-rule"></div>
    <div class="mast-rule-thin"></div>
  </div>

  <div class="subbar">
    <div class="item">资讯 <strong>{{ news_count }}</strong></div>
    <div class="item">法规 <strong>{{ policy_count }}</strong></div>
    {% if company_count and company_count > 0 %}
    <div class="item">公司动态 <strong>{{ company_count }}</strong></div>
    {% endif %}
    <div class="item">技术 <strong>{{ tech_count }}</strong></div>
    <div class="item">市场 <strong>{{ market_count }}</strong></div>
    <div class="item">政策 <strong>{{ policy_tag_count }}</strong></div>
  </div>

  <div class="content">
    {% if featured %}
    <div class="featured">
      <div class="kicker">&#9733; 头版头条</div>
      <h1>{{ featured.title }}</h1>
      {% if featured.display_text %}
      <div class="deck">{{ featured.display_text[:150] }}{% if featured.display_text|length > 150 %}...{% endif %}</div>
      {% endif %}
      <div class="byline">
        <span>来源：{{ featured.source or '网络综合' }}</span>
        <span>{{ featured.date_short }}</span>
      </div>
      {% if featured.display_text %}
      <div class="body-text">{{ featured.display_text }}</div>
      {% endif %}
      {% if featured.has_valid_link and featured.link %}
      <a class="read-more" href="{{ featured.link }}" target="_blank" rel="noopener noreferrer">查看原文 &#9656;</a>
      {% endif %}
    </div>
    {% endif %}

    {% if two_col_news %}
    <div class="two-col">
      {% for story in two_col_news %}
      <div class="story">
        <h3>{{ story.title }}</h3>
        <div class="meta">{{ story.tag }} · {{ story.source or '网络综合' }} · {{ story.date_short }}</div>
        {% if story.display_text %}
        <p>{{ story.display_text[:200] }}{% if story.display_text|length > 200 %}...{% endif %}</p>
        {% else %}
        <p style="color:#999;font-style:italic;">点击标题查看详情</p>
        {% endif %}
        {% if story.has_valid_link and story.link %}
        <a class="read-more" href="{{ story.link }}" target="_blank" rel="noopener noreferrer">查看原文 &#9656;</a>
        {% endif %}
      </div>
      {% endfor %}
    </div>
    {% endif %}

    <div class="sec-head">政策法规追踪</div>
    <div class="policy-list">
      {% for pol in policies %}
      <div class="pol-item">
        <div class="pol-bullet {% if pol.status == '新发布' %}pol-new{% else %}pol-active{% endif %}"></div>
        <div class="pol-text">
          <span class="status {% if pol.status == '新发布' %}st-new{% else %}st-active{% endif %}">{{ pol.status }}</span>
          {% if pol.has_valid_link and pol.link %}
          <a href="{{ pol.link }}" target="_blank" rel="noopener noreferrer">{{ pol.title }}</a>
          {% else %}
          <strong>{{ pol.title }}</strong>
          {% endif %}
        </div>
        <div class="pol-date">{{ pol.date }}</div>
      </div>
      {% endfor %}
      {% if policies|length == 0 %}
      <div class="pol-item">
        <div class="pol-bullet pol-active"></div>
        <div class="pol-text"><span class="status st-active">提示</span>本期暂无新政策法规更新</div>
        <div class="pol-date"></div>
      </div>
      {% endif %}
    </div>

    {% if briefs %}
    <div class="briefs">
      {% for brief in briefs %}
      <div class="brief">
        <h4>{{ brief.title }}</h4>
        <div class="meta">{{ brief.tag }} · {{ brief.date }}</div>
        <p>{{ brief.summary }}</p>
      </div>
      {% endfor %}
    </div>
    {% endif %}

    {% if keywords %}
    <div class="keywords">
      <div class="kw-label">本期关键词</div>
      <div class="kw-chips">
        {% for kw in keywords %}
        <span class="kw-chip{% if loop.first %} featured-chip{% endif %}">{{ kw }}</span>
        {% endfor %}
      </div>
    </div>
    {% endif %}

    <div class="colophon">
      <div class="name">HONESS ENVIRONMENTAL</div>
      <div>本日报由泓济环保行业日报系统自动生成 · Powered by GitHub Actions</div>
    </div>
  </div>
</div>
</body>
</html>
